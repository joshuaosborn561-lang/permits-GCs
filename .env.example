# Server
PORT=8080
NODE_ENV=production

# Demo mode: synthetic data, no paid API calls (use for local UI smoke tests)
DEMO_MODE=false

# OpenAI — use a nano-tier model for structured extraction
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# Apify
APIFY_TOKEN=

# Supabase — same credentials as the google-maps-scraper Railway service
SUPABASE_URL=https://kemvxzhcxvynmoutwdrh.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_INGEST_SECRET=

# Contact enrichment waterfall
GETLEADS_API_KEY=
GETLEADS_BASE_URL=https://api.getleads.io
AI_ARK_API_KEY=
AI_ARK_BASE_URL=https://api.ai-ark.com
LEADMAGIC_API_KEY=

# Pipeline tunables
LOOPNET_FALLOUT_PCT=0.50
# LoopNet PM lookup: off | batched (default, cheap) | per_property (EXPENSIVE)
LOOPNET_MODE=batched
LOOPNET_BATCH_SIZE=50
# Detail pages can bill ~$0.05 each via unblocker — keep false
LOOPNET_INCLUDE_DETAILS=false
LOOPNET_MAX_UNBLOCKER_REQUESTS=5
GOOGLE_SEARCH_HARD_CAP=5000
PROPWIRE_BATCH_SIZE=50
MAX_CONCURRENT_APIFY=3
